APP_ENV=development
APP_DEBUG=true
APP_URL=https://diasfestivosmunicipios.free.nf
BASE_URL=/public

# ============================================
# API
# ============================================
API_KEY=LA_APIKEY_DEL_MOMINIO_QUE_SE_ENCUENTRA_EN_BBDD
API_BASE=api/v1

# ============================================
# BASE DE DATOS (Local)
# ============================================
DB_HOST=hosst_name
DB_PORT=puerto
DB_NAME=nombre_BBDD
DB_USER=user_BBDD
DB_PASSWORD=pass_BBDD
